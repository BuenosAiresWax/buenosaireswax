{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "functions": {
        "api/email/enviar.js": {
            "maxDuration": 60
        },
        "api/email/envios.js": {
            "maxDuration": 30
        },
        "api/email/abandonados.js": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/email/abandonados",
            "schedule": "0 14 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
