VITE_CLUB_CODE=tu_codigo_club
VITE_ACCESS_VERSION=19
VITE_DROP_DATE=2026-08-06T20:00:00-03:00

# MercadoPago (solo en Vercel Environment Variables, NO en .env)
# MP_ACCESS_TOKEN=APP_USR-xxx
# MP_PUBLIC_KEY=APP_USR-xxx
# MP_WEBHOOK_SECRET=xxx

# Firebase Admin (solo en Vercel Environment Variables, NO en .env)
# FIREBASE_PROJECT_ID=tu_proyecto_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu_proyecto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv..."

# Resend - emails de bienvenida del Club de Vinilos (solo en Vercel Environment Variables)
# Mientras no verifiques el dominio, usá onboarding@resend.dev (solo envía al email dueño de la cuenta).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=BAWAX Club de Vinilos
# RESEND_REPLY_TO=buenosaireswax@gmail.com
# RESEND_WELCOME_SUBJECT=Bienvenido al Club de Vinilos de BAWAX
